<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        Template only. The client id and client secret are NOT stored in source control.
        After deploying, open Setup > Named Credentials > External Credentials > Partner Auth,
        edit the "PartnerAuthPrincipal" principal and add two authentication parameters:
          ClientId     = <your client id>
          ClientSecret = <your client secret>
        Apex reads them only through the {!$Credential.PartnerAuth.*} merge fields at callout time.
    -->
    <authenticationProtocol>Custom</authenticationProtocol>
    <externalCredentialParameters>
        <parameterGroup>PartnerAuthPrincipal</parameterGroup>
        <parameterName>PartnerAuthPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Partner Auth</label>
</ExternalCredential>
